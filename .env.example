# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Bring-your-own-key: the tool uses YOUR keys, so API terms are between you and
# the provider. Note VirusTotal's free/public API is non-commercial use only.

VIRUSTOTAL_API_KEY=
# Free key at abuseipdb.com -> account -> API. Corroborates IP reputation.
ABUSEIPDB_API_KEY=
# Free Auth-Key at auth.abuse.ch. URLhaus malware-host lookup (IP + domain).
URLHAUS_AUTH_KEY=
# Optional: raises the NVD rate limit (request one free at nvd.nist.gov).
NVD_API_KEY=
